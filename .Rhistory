# Generate random data with different skewness
set.seed(123)
# Data with no skewness (symmetrical)
data1 <- rnorm(1000)
# Positively skewed data
data2 <- rgamma(1000, shape = 2, scale = 1)
# Negatively skewed data
data3 <- rchisq(1000, df = 3)
# Highly positively skewed data
data4 <- rexp(1000, rate = 2)
# Create a 2x2 layout for the histograms
par(mfrow = c(2, 2))
# Plot histograms
hist(data1, main = "No Skewness (Symmetrical)", xlab = "Value", col = "blue", breaks = 20)
hist(data2, main = "Positively Skewed", xlab = "Value", col = "green", breaks = 20)
hist(data3, main = "Negatively Skewed", xlab = "Value", col = "red", breaks = 20)
hist(data4, main = "Highly Positively Skewed", xlab = "Value", col = "purple", breaks = 20)
# Reset the layout to default
par(mfrow = c(1, 1))
# Generate random data with different skewness
set.seed(123)
# Data with no skewness (symmetrical)
data1 <- rnorm(1000)
# Positively skewed data
data2 <- rgamma(1000, shape = 2, scale = 1)
# Negatively skewed data
data3 <- rchisq(1000, df = 3)
# Highly positively skewed data
data4 <- qexp(rexp(1000, rate=5), rate = 5)
# Create a 2x2 layout for the histograms
par(mfrow = c(2, 2))
# Plot histograms
hist(data1, main = "A", xlab = "Value", col = "blue", breaks = 20)
hist(data2, main = "B", xlab = "Value", col = "green", breaks = 20)
hist(data3, main = "C", xlab = "Value", col = "red", breaks = 20)
hist(data4, main = "D", xlab = "Value", col = "purple", breaks = 20)
