set2 <- c("B", "C", "E", "F")
# Create the Venn diagram for the intersection
venn.plot <- venn.diagram(
x = list(Set1 = set1, Set2 = set2),
category.names = c("Set 1", "Set 2"),
filename = NULL,
output=TRUE
)
